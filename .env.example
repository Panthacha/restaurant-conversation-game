# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API). See docs/SUPABASE_SETUP.md.
# Without them the game still runs, but only in guest mode (progress saved on this device only).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Gemini API key for the AI grammar checker (get one free at https://aistudio.google.com/apikey).
# Server-only: never prefix this with NEXT_PUBLIC_, or it would ship to the browser.
# Without it, the grammar checker reports itself as unavailable; the rest of the game is unaffected.
GEMINI_API_KEY=
